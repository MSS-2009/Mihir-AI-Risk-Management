# Copy to backend/.env for local dev, or set these in your host's dashboard.
#
# NEVER commit the real file. .gitignore excludes .env and .env.* (allowing
# .env.example), and every commit in this repo is checked for key material.
# Do not paste real values into a chat transcript either: set them yourself and
# say they are set, rather than saying what they are.

# ---------------------------------------------------------------------------
# AI interpretation (optional)
# The app runs WITHOUT this: narratives fall back to deterministic text and
# document extraction degrades to keyword matching. No number ever depends on it.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Merge (hosted accounting and ERP connectors)
#
# ONE key, held by us, for all customers. Each customer authenticates through
# Merge Link, Merge's own hosted flow, and we store the account token it returns.
# The customer never needs an API key and never gives us a password, which is
# what keeps the /security claim true.
#
# Production and sandbox are separate keys. Start on sandbox.
# Dashboard: app.merge.dev > Keys
#
# NOT Merge Gateway. There is an unrelated LLM-routing product with almost the
# same name whose dashboard shows projects, routing policies and token spend.
# The right one shows Linked Accounts and Integrations. Its keys start 'mg_' and
# will never authenticate here; `MergeProvider.preflight()` says so by name
# rather than leaving you to read another "Invalid Production Key."
# ---------------------------------------------------------------------------
MERGE_API_KEY=
MERGE_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Supabase (persistence, auth, row-level security)
#
# The service-role key bypasses row-level security, so it is SERVER-SIDE ONLY
# and must never reach the browser or the frontend build. The anon key is the
# one the frontend gets.
#
# Separate projects for development and production.
# Dashboard: supabase.com/dashboard > Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Creating the tables is a third credential doing a different job. The
# service-role key reads and writes ROWS and cannot run DDL, so table creation
# goes through a personal access token (Supabase > Account > Access Tokens,
# 'sbp_...'). Put it here and `python supabase/apply.py` will pick it up.
#
# This one is ADMIN-ONLY, not a runtime credential. Avenoir never reads it while
# serving a request, so it does not belong in Render's environment: creating
# tables is something a developer does once from a laptop, not something a web
# service does on boot. Setting it there would hand a server that faces the
# internet the ability to drop every table it stores, for no gain.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Local file-backed store (used when SUPABASE_URL is unset)
# Defaults to backend/.data, which is gitignored because it holds customer data.
# ---------------------------------------------------------------------------
AVENOIR_DATA_DIR=
