# Production default, committed on purpose.
#
# Without this a production build falls back to http://localhost:8000, which
# works on any machine that happens to be running the backend and fails for
# everyone else. That is a bad failure: the site looks deployed, and only the
# people who built it can use it.
#
# A Vercel dashboard variable still wins over this file, so setting one there
# overrides it without a code change.
NEXT_PUBLIC_API_URL=https://avenoir-api.onrender.com
